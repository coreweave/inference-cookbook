{
  "name": "qwen3-4b-hotload",
  "gatewayIds": ["<gateway uuid in one zone>"],
  "runtime": {
    "engine": "dynamo-vllm",
    "version": "0.32.0+crwv.5",
    "engineConfig": {
      "gpu-memory-utilization": "0.50",
      "max-model-len": "8192"
    },
    "engineEnv": {
      "MX_REFIT_DELTA_SURGICAL": "true",
      "MX_REFIT_FULL_STREAMING": "true",
      "MX_REFIT_INPLACE": "true",
      "MX_REFIT_PREFER_PREPARED": "true",
      "MX_REFIT_PREFETCH": "true",
      "MX_REFIT_PREFETCH_S3_WATCH": "true"
    }
  },
  "resources": {"instanceType": "gb300-4x", "gpuCount": 1},
  "model": {
    "name": "qwen3-4b-hotload",
    "bucket": "<bucket>",
    "path": "models/Qwen3-4B"
  },
  "autoscaling": {"min": 2, "max": 2, "concurrency": 256},
  "traffic": {"weight": 100},
  "hotLoad": {
    "bucket": "<bucket>",
    "pathPrefix": "hotload",
    "transitionMode": "TRANSITION_MODE_ASYNC"
  }
}
