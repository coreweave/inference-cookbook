# Values that render.sh (envsubst) fills into the slime recipe's manifests
# (training/recipes/slime/k8s/) and the shared ones in k8s/ at the repository root.
NAMESPACE=hotload-recipe
# ConfigMap that carries the wheel and scripts (make-kit.sh); one per example if you run several.
KIT_NAME=cwtrain-kit
# Object storage: a bucket owned by the deployment's organization. Each Secret holds AWS-style
# "config" and "credentials" files. The trainer Job mounts STORAGE_SECRET: with Workload Identity
# Federation it holds no key (make-storage-secret.sh with WORKLOAD_IDENTITY=1), else the trainer's
# key. ADMIN_STORAGE_SECRET has the admin's key, for the Jobs that create the bucket and stage the
# base model (README, "What you need").
BUCKET="<bucket>"
STORAGE_SECRET=object-storage-credentials
ADMIN_STORAGE_SECRET=object-storage-admin-credentials
# https://cwobject.com works from anywhere. Inside a CoreWeave (CKS) cluster, http://cwlota.com
# caches reads, such as staging the base model, but does not speed up checkpoint uploads. Set one
# of them here, or leave it empty to use the endpoint in the storage Secret's config.
CW_S3_ENDPOINT=https://cwobject.com
# For make-bucket-job.yaml:
# - BUCKET_ZONE: the bucket's Availability Zone (required). It must offer AI Object Storage, such as
#   US-EAST-04A. S3 tools call it the region. make-storage-secret.sh needs the same zone.
# - PLATFORM_PRINCIPAL_ARN: the canonical CoreWeave Inference service account, the same for all
#   customers (Dedicated Inference docs, "Grant inference access to your bucket").
# - ORG_ID: your org id (Cloud Console -> Settings), for the org statement.
BUCKET_ZONE="<availability zone>"
PLATFORM_PRINCIPAL_ARN=arn:aws:iam::cw4637:coreweave/uvAGGQSxxXeeQBJzcGsD9
ORG_ID="<your org id>"
# The trainer's principal, which may write only under HOTLOAD_PREFIX. By default the trainer Job
# runs as the Kubernetes service account TRAINER_SERVICE_ACCOUNT, which gets temporary credentials
# through Workload Identity Federation (README, "What you need"). The cluster's OIDC issuer URL is
# on its page in the Cloud Console. To use a Cloud Console user's key instead, set
# TRAINER_PRINCIPAL_ARN to arn:aws:iam::<org id>:coreweave/<user id>, and TRAINER_SERVICE_ACCOUNT
# to empty.
TRAINER_SERVICE_ACCOUNT=cwtrain-trainer
TRAINER_PRINCIPAL_ARN="arn:aws:iam::${ORG_ID}:role/<cluster OIDC issuer URL>:system:serviceaccount:${NAMESPACE}:${TRAINER_SERVICE_ACCOUNT}"
# The admin: the Cloud Console user whose key is in ADMIN_STORAGE_SECRET. The user ID is on that
# user's Settings page. The admin creates the bucket, stages the base model and cleans up.
ADMIN_PRINCIPAL_ARN="arn:aws:iam::${ORG_ID}:coreweave/<admin user id>"
# Base model to stage and train, and where it lands in the bucket.
HF_MODEL=Qwen/Qwen3-4B
# Pin the model bytes used by both staging and training; replace when choosing another model.
HF_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
MODEL_SLUG=Qwen3-4B
# Lowercase name used for the Jobs (RFC 1123).
JOB_NAME=qwen3-4b
MODEL_PREFIX=models
# The deployment's hotLoad.pathPrefix, where the trainer writes snapshots. Keep the two the same.
# Every example uses the same prefix; each run's snapshots go under <prefix>/<RUN_ID>-vNNNNNN/.
# Cleaning up removes only the runs of this run.env's deployment.
HOTLOAD_PREFIX=hotload
# Optional: fetch the base checkpoint from the deployment's own model path instead of HF_MODEL.
BASE_S3_URI=
# The deployment's id: the "id" that `cwtrain deployment create` prints (README, "Creating the
# deployment").
DEPLOYMENT_ID="<deployment id>"
# Snapshot identities are <RUN_ID>-vNNNNNN and must be new for every run. The default takes the
# time of each render plus a random number (README, "Watching and re-running"). $RANDOM works
# because bash (render.sh) and bash or zsh (when you load this file) read it.
RUN_ID=qwen3-4b-grpo-$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM
# Rollouts: the deployment's OpenAI-compatible endpoint (the "rollout_base_url" that
# `cwtrain deployment create` prints), the served model name (its "model_name"), and the Secret
# holding the inference API key under the key "api_key".
ROLLOUT_BASE_URL="https://<gateway host>/v1"
ROLLOUT_MODEL=qwen3-4b-hotload
INFERENCE_KEY_SECRET=inference-api-key
# Group requests the trainer keeps in flight, each asking for --n-samples-per-prompt completions
# (4 by default). The deployment runs at most replicas x autoscaling.concurrency sequences at once
# and queues the rest (README, "Concurrency").
ROLLOUT_CONCURRENCY=16
# CoreWeave API: the token is in the Secret API_TOKEN_SECRET, under the key "token" (README,
# "Running it on Kubernetes"). The URL, extra headers and TLS switch are for test API servers; keep
# the defaults for CoreWeave's API. The trainer Job always needs the Secret, so create one with any
# value for a server that authenticates by headers only.
COREWEAVE_API_URL=https://api.coreweave.com
API_TOKEN_SECRET=coreweave-api-token
# JSON must be single-quoted so the shell keeps the double quotes, e.g. '{"X-Header":"value"}'
CWTRAIN_API_HEADERS=
CWTRAIN_API_INSECURE=0
# Trainer shape.
# radixark/miles carries slime's dependency stack for amd64 and arm64 (GB200/GB300). The launcher
# clones slime at SLIME_COMMIT into it. The slime and Megatron settings below go with this image.
# The official slimerl/slime images are amd64 only: with one of them, set SLIME_RELAX_NUMPY_CHECK=0
# and leave MEGATRON_COMMIT empty (the recipe's README, "Tested versions").
TRAINER_IMAGE=radixark/miles:v0.1.1@sha256:6355834f16bacd35d5d40c43f142e3758376f7b2e8d678bccfe870c092bd96bf
# slime source: a clone of SLIME_REPO at SLIME_COMMIT. An image's own /root/slime clone is moved to
# that commit. The default is the commit the recipe's patches are tested against. The Job stops
# before training if a patch does not apply. SLIME_DIR names a checkout to use as it is instead.
SLIME_REPO=https://github.com/THUDM/slime
SLIME_COMMIT=8ee9c1e1c8871ccd6dc8ec812edfaefa3dd1156b
SLIME_DIR=
SLIME_MODEL_SCRIPT=qwen3-4B
# slime asserts numpy 1.x for Megatron. Set 1 on images whose Megatron runs on numpy 2, such as
# radixark/miles; 0 on the official slime images.
SLIME_RELAX_NUMPY_CHECK=1
# The Megatron-LM commit slime is developed against (MEGATRON_COMMIT in the slime repo's
# docker/Dockerfile). The launcher checks it out, applies slime's Megatron patches and puts it first
# on PYTHONPATH. Leave it empty on the official slime images, which carry slime's own Megatron.
MEGATRON_COMMIT=1dcf0dafa884ad52ffb243625717a3471643e087
INSTANCE_TYPE=gb300-4x
ACTOR_GPUS=2
TP_SIZE=2
NUM_ROLLOUT=30
ROLLOUT_MAX_RESPONSE_LEN=2048
# Publish a full snapshot every N versions, which cuts the delta chain, and verify every delta
# against a trainer-side mirror of the served weights. Default 20, at most 64: a replica that starts
# with no peer to copy weights from replays at most 63 deltas. 0 = deltas only, no mirror.
FULL_EVERY=20
# Hot-load behaviour (the recipe's README, "Configure the hook"):
# - HOTLOAD_WAIT: 1 blocks training until every replica serves a version; 0 does not.
# - HOTLOAD_TIMEOUT: seconds one hot-load may take. Empty uses cwtrain's default, 1800.
# - HOTLOAD_VERIFY: 1 re-checks the replicas after each hot-load.
# - HOTLOAD_PROMPT_CACHE_POLICY: preserve or reset_all. Empty keeps the launcher's choice.
HOTLOAD_WAIT=1
HOTLOAD_TIMEOUT=1800
HOTLOAD_VERIFY=0
HOTLOAD_PROMPT_CACHE_POLICY=
# Reward: 'math' grades the boxed answer anywhere in the response. 'deepscaler' grades only text
# after a </think> marker, so it scores 0 when thinking is off or truncated.
RM_TYPE=math
# Extra train.py flags. Qwen3 thinks by default and fills the response budget, so turn it off.
EXTRA_TRAIN_ARGS='--apply-chat-template-kwargs '"'"'{"enable_thinking":false}'"'"''
