+def _should_start_rollout_servers(args) -> bool:
+    """False when the run owns no rollout engines: --debug-train-only, or a standalone
+    disk-delta publisher (--update-weight-standalone-publish with --rollout-num-gpus 0) whose
+    rollouts come from an external service."""
+    return not args.debug_train_only and not (
+        getattr(args, "update_weight_standalone_publish", False) and args.rollout_num_gpus == 0
+    )
