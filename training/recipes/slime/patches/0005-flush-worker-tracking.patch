@@ -0,0 +1,29 @@
+"""Flush secondary writers before their owner terminates training actors."""
+
+import logging
+
+import ray
+
+from slime.utils.cleanup import Cleanup
+
+logger = logging.getLogger(__name__)
+
+
+def flush_training_actors(actors, timeout=60):
+    # Start all writers together; one deadline bounds the whole group.
+    pending = [actor.finish_tracking.remote() for actor in actors]
+    flushed = 0
+    with Cleanup(timeout) as cleanup:
+        for ref in pending:
+            def wait(ref=ref):
+                try:
+                    ray.get(ref, timeout=cleanup.remaining)
+                    return True
+                except ray.exceptions.RayActorError:
+                    # A failed/released worker cannot flush; still flush its peers.
+                    logger.warning("Training actor already exited; its metrics cannot be flushed")
+                    return False
+
+            if cleanup.run("flush training metrics", wait):
+                flushed += 1
+    logger.info("Flushed training metrics from %d/%d workers", flushed, len(pending))
