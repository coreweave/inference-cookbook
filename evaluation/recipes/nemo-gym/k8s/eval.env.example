# Values consumed by render.sh / envsubst for eval-job.yaml. Use the NeMo-RL recipe's run.env values
# for the namespace, endpoint, model and Secrets, so that the eval runs next to the trainer and
# against the same hot-load deployment.
NAMESPACE=hotload-recipe
# ConfigMap with the wheel, launcher and configs (make-kit.sh).
EVAL_KIT_NAME=cwtrain-gym-kit
# Lowercase name for the Job (RFC 1123); use a new one for each evaluation.
EVAL_NAME=browsecomp-$(date -u +%Y%m%dt%H%M%S)
# The evaluation (browsecomp) and the number of tasks to collect.
BENCHMARK=browsecomp
LIMIT=5
# Tasks in flight. The example deployment has 4 replicas x 8 slots; keep this at or below 32.
EVAL_CONCURRENCY=8
# BrowseComp agent context: the deployment's max-model-len.
MAX_CONTEXT_TOKENS=32768
# Tool-calling turns per task. Gym's benchmark allows 400; a lower cap bounds the eval's time.
MAX_STEPS=50
# The NeMo-RL recipe's hot-load deployment: ROLLOUT_BASE_URL and ROLLOUT_MODEL from its run.env.
ROLLOUT_BASE_URL="https://<gateway host>/v1"
ROLLOUT_MODEL=nemotron-lightning-hotload
INFERENCE_KEY_SECRET=inference-api-key
# The judge, and the Secret with its key under "judge_api_key" and the You.com key under
# "search_api_key": the NeMo-RL example's GYM_SECRET.
JUDGE_BASE_URL=https://api.inference.wandb.ai/v1
JUDGE_MODEL=zai-org/GLM-5.2
GYM_SECRET=gym-api-keys
# CPU image with Python 3.13; run-eval.sh installs git, uv, Gym and cwtrain into it.
EVAL_IMAGE=python:3.13-slim
GYM_REF=v0.6.0
