# Values consumed by render.sh / envsubst for the manifests in this directory.
NAMESPACE=hotload-recipe
# ConfigMap that carries the wheel and scripts (make-kit.sh); one per recipe if you run both.
KIT_NAME=cwtrain-kit
# Object storage: a bucket owned by the deployment's organization. Each Secret holds AWS-style
# "config" and "credentials" files. The trainer Job mounts STORAGE_SECRET: with Workload Identity
# Federation it holds no key (make-storage-secret.sh with WORKLOAD_IDENTITY=1), else the trainer's
# key. ADMIN_STORAGE_SECRET has the admin's key, for the Jobs that create the bucket and stage the
# base model (README, "What you need").
BUCKET="<bucket>"
STORAGE_SECRET=object-storage-credentials
ADMIN_STORAGE_SECRET=object-storage-admin-credentials
# https://cwobject.com works from anywhere. In a CoreWeave (CKS) cluster, http://cwlota.com caches
# reads, such as staging the base model. It does not make checkpoint uploads faster. Set it here
# to use that cache. Leave this empty to use the endpoint in the storage Secret's config.
CW_S3_ENDPOINT=https://cwobject.com
# For make-bucket-job.yaml:
# BUCKET_ZONE: required. An Availability Zone with AI Object Storage, such as US-EAST-04A. S3 tools
#   call it the region. make-storage-secret.sh needs the same zone.
# PLATFORM_PRINCIPAL_ARN: the CoreWeave Inference service account, the same for all customers (see
#   the Dedicated Inference docs, "Grant inference access to your bucket").
# ORG_ID: your org id (Cloud Console -> Settings), for the org statement.
BUCKET_ZONE="<availability zone>"
PLATFORM_PRINCIPAL_ARN=arn:aws:iam::cw4637:coreweave/uvAGGQSxxXeeQBJzcGsD9
ORG_ID="<your org id>"
# The trainer's principal, which may write only under HOTLOAD_PREFIX. By default the trainer Job
# runs as the Kubernetes service account TRAINER_SERVICE_ACCOUNT, which gets temporary credentials
# through Workload Identity Federation (README, "What you need"). The cluster's OIDC issuer URL is
# on its page in the Cloud Console. To use a Cloud Console user's key instead, set
# TRAINER_PRINCIPAL_ARN to arn:aws:iam::<org id>:coreweave/<user id>, and TRAINER_SERVICE_ACCOUNT
# to empty.
TRAINER_SERVICE_ACCOUNT=cwtrain-trainer
TRAINER_PRINCIPAL_ARN="arn:aws:iam::${ORG_ID}:role/<cluster OIDC issuer URL>:system:serviceaccount:${NAMESPACE}:${TRAINER_SERVICE_ACCOUNT}"
# The admin: the Cloud Console user whose key is in ADMIN_STORAGE_SECRET. The user ID is on that
# user's Settings page. The admin creates the bucket, stages the base model and cleans up.
ADMIN_PRINCIPAL_ARN="arn:aws:iam::${ORG_ID}:coreweave/<admin user id>"
# Base model to stage and train, and where it lands in the bucket.
HF_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
# Pin the model bytes used by both staging and training; replace when choosing another model.
HF_REVISION=a9904d24bcc1d289a1950fa9d2b978c47cf903b9
MODEL_SLUG=NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
# Lowercase name used for the Jobs (RFC 1123).
JOB_NAME=nemotron-lightning
# Use a new value for each inference deployment, so that deployments do not share weight UIDs.
DEPLOYMENT_RUN="<unique-deployment-id>"
MODEL_PREFIX=cookbook/${DEPLOYMENT_RUN}/models
# The deployment's hotLoad.pathPrefix, where the trainer writes snapshots. Keep the two the same.
# Every recipe uses the same prefix; each run's snapshots go under <prefix>/<RUN_ID>-vNNNNNN/.
# Cleaning up removes only the runs of this run.env's deployment.
HOTLOAD_PREFIX=hotload
# Where the trainer fetches the base model. Required: the launcher does not download from Hugging
# Face. The default is where stage-nemotron-job.yaml uploads it, the copy the deployment loads.
BASE_S3_URI=s3://${BUCKET}/${MODEL_PREFIX}/${MODEL_SLUG}
# The deployment's id: the "id" that `cwtrain deployment create` prints (README, "Creating the
# deployment").
DEPLOYMENT_ID="<deployment id>"
# Snapshot identities are <RUN_ID>-vNNNNNN and must be new for every run. The default uses the
# render time plus a random number (README, "Watching and re-running"). bash (render.sh) and bash
# or zsh (when you load this file) provide $RANDOM.
RUN_ID=nemotron-lightning-grpo-$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM
# Rollouts: the deployment's OpenAI-compatible endpoint (the "rollout_base_url" that
# `cwtrain deployment create` prints), the served model name (its "model_name"), and the Secret
# holding the inference API key under the key "api_key".
ROLLOUT_BASE_URL="https://<gateway host>/v1"
ROLLOUT_MODEL=nemotron-lightning-hotload
INFERENCE_KEY_SECRET=inference-api-key
# Requests the trainer keeps in flight. Each is one prompt that asks for
# grpo.num_generations_per_prompt completions (4 by default). The deployment runs at most
# replicas x autoscaling.concurrency sequences at once and queues the rest (README, "Concurrency").
ROLLOUT_CONCURRENCY=32
# CoreWeave API: the token is in the Secret API_TOKEN_SECRET, under the key "token" (README,
# "Running it on Kubernetes"). The URL, extra headers and TLS switch below are for test API
# servers; keep the defaults for CoreWeave's API. The trainer Job always needs the Secret. For a
# server that authenticates by headers only, put any value in it.
COREWEAVE_API_URL=https://api.coreweave.com
API_TOKEN_SECRET=coreweave-api-token
# JSON must be single-quoted so the shell keeps the double quotes, e.g. '{"X-Header":"value"}'
CWTRAIN_API_HEADERS=
CWTRAIN_API_INSECURE=0
# Trainer shape.
# NeMo-RL release container (amd64 and arm64 on NGC); the launch script patches its /opt/nemo-rl.
TRAINER_IMAGE=nvcr.io/nvidia/nemo-rl:v0.7.0@sha256:75c4821c7f24d6a045d22ce51756bd7ea9ec208020c90233723b9d7a9727d681
INSTANCE_TYPE=gd-8xh100ib-i128
ACTOR_GPUS=8
NUM_STEPS=30
# Publish a full snapshot every N refits, which ends the delta chain. Other refits publish the XOR
# delta between consecutive weight exports. Default 20, at most 64: a replica that starts with no
# peer to copy the weights from replays at most 63 deltas.
FULL_EVERY=20
# Hot-load behavior (README, "Configure"):
# HOTLOAD_WAIT: 1 blocks training until every replica serves the new version, 0 does not.
# HOTLOAD_TIMEOUT: seconds one hot-load may take (empty: cwtrain's default, 1800).
# HOTLOAD_VERIFY: 1 checks the replicas again after each hot-load.
# HOTLOAD_PROMPT_CACHE_POLICY: preserve or reset_all (empty: the launcher chooses).
HOTLOAD_WAIT=1
HOTLOAD_TIMEOUT=1800
HOTLOAD_VERIFY=0
HOTLOAD_PROMPT_CACHE_POLICY=
# Extra hydra-style overrides for run_grpo.py (space separated), e.g. grpo.num_prompts_per_step=16
EXTRA_OVERRIDES=
